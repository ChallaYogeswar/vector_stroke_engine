# Copy this file to `.env.local` (git-ignored) and fill in the key.
#
# ONLY needed for the optional AI endpoints (/api/describe, /api/path-feeder).
# The app itself (upload, cleanup, all five render modes, export) works with no key.
#
# SERVER-SIDE ONLY. Do NOT rename this to VITE_ANTHROPIC_API_KEY — Vite exposes
# every VITE_-prefixed variable to the browser bundle, which would leak the key.
# vite.config.ts loads it into the Node process only.
#
# Production (Vercel): set it under Project Settings -> Environment Variables.
ANTHROPIC_API_KEY=
